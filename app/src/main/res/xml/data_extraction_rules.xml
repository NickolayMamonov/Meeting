<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Исключаем зашифрованные preferences с токенами -->
        <exclude domain="sharedpref" path="secure_auth_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- При переносе данных между устройствами токены тоже не переносим -->
        <exclude domain="sharedpref" path="secure_auth_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>