<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude auth token storage from backup. -->
    <exclude domain="file" path="datastore/secure_token_store.preferences_pb"/>
    <exclude domain="file" path="datastore/secure_auth_session_store.preferences_pb"/>
    <exclude domain="file" path="datastore/pending_email_otp_store.preferences_pb"/>
    <!-- Firebase Installation IDs are device-specific and must not transfer to another device. -->
    <exclude domain="file" path="datastore/pending_push_registration_store.preferences_pb"/>
    <exclude domain="sharedpref" path="meeting_token_keyset_prefs.xml"/>
</full-backup-content>
