<?xml version="1.0" encoding="utf-8"?>
<!--
    Release network security config.
    - Cleartext (HTTP) запрещён для всех доменов — только HTTPS.
    - Certificate pinning для прод-хоста: см. <domain-config> ниже.

    ВАЖНО:
    - <pin> = base64(SHA-256(SubjectPublicKeyInfo)), НЕ отпечаток сертификата.
    - Обязательно ≥2 пина: текущий ключ + backup. Один пин = риск кирпича при ротации.
    - expiration — предохранитель: после даты пиннинг НЕ enforced (fail-open
      к системным trust-anchors). Ставить с запасом, продлевать с релизами.
    - <domain> должен совпадать с хостом из BuildConfig.BASE_URL (BASE_URL_RELEASE).
    - Вычисление SPKI-хеша — команда openssl в roadmap §2.24.
-->
<network-security-config>
    <!-- Базовая политика: только HTTPS, системные центры доверия. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Пиннинг прод-API. Заменить api.example.com на реальный хост из BASE_URL_RELEASE. -->
    <domain-config>
        <domain includeSubdomains="true">api.example.com</domain>
        <pin-set expiration="2026-12-01">
            <!-- TODO(release-blocker): вставить реальные SPKI-хеши ДО публикации.
                 Заглушки ниже гарантированно оборвут TLS в release. -->
            <!-- Текущий leaf/key -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <!-- Backup: offline-ключ ИЛИ промежуточный CA -->
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
    </domain-config>
</network-security-config>